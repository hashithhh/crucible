__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/
.ruff_cache/
.venv/
*.egg-info/

# trained tokenizer artifacts (scratch); the production tokenizer under
# models/ is versioned, because Phase 3 training depends on that exact file
*.model
*.vocab
!models/*.model

# data and generated output
data/
figures/
crucible_feasibility.json

# local tool state
.serena/

# Phase 3 training checkpoints: ~300 MB each, reproducible from the log
checkpoints/

# Console output of detached training runs; the per-run .jsonl logs are the record
results/phase*/*_run.log
results/phase*/*_run.err
